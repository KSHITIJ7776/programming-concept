# 3. Sum of Even Numbers in a List
# ==========================================

def sum_even(numbers):
    total = 0

    for num in numbers:
        if num % 2 == 0:
            total += num

    return total

numbers = [10, 15, 20, 25, 30, 35]

print("\nList:", numbers)
print("Sum of Even Numbers =", sum_even(numbers))


